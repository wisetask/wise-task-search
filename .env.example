# Подключение к PostgreSQL с расширением pgvector.
# Можно задать одной строкой:
# SEARCH_DATABASE_URL=postgresql://wise_task_search:wise_task_search@localhost:5432/wise_task_search
# либо отдельными переменными:
SEARCH_DB_HOST=localhost
SEARCH_DB_PORT=5432
SEARCH_DB=wise_task_search
SEARCH_DB_USER=wise_task_search
SEARCH_DB_PASSWORD=wise_task_search

# Размерность эмбеддингов (BAAI/bge-m3 -> 1024). Должна совпадать с vector(N) в init.sql.
EMBEDDING_DIM=1024

# Модель эмбеддингов (путь или имя в sentence-transformers).
# BGE_M3_MODEL_PATH=/app/semantic_search_api/bge_m3_model
# BGE_M3_MODEL=BAAI/bge-m3
